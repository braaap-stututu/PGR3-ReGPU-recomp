+    b = ctypes.create_string_buffer(n)
+    _keep.append(b)
+    return ctypes.addressof(b)
+
+ctx = ctypes.c_void_p()
+assert adl.ADL2_Main_Control_Create(_malloc, 1, ctypes.byref(ctx)) == 0, 'ADL init failed'
+
