+         14: 'fan_rpm', 15: 'fan_pct', 19: 'gfx_activity', 20: 'mem_activity', 21: 'gfx_mV', 23: 'asic_W',
+         27: 'temp_hotspot', 29: 'board_W', 73: 'power_W?'}
+
+n = ctypes.c_int()
+adl.ADL2_Adapter_NumberOfAdapters_Get(ctx, ctypes.byref(n))
+
+def read(i):
+    o = Output()
+    o.size = ctypes.sizeof(Output)
+    if adl.ADL2_New_QueryPMLogData_Get(ctx, i, ctypes.byref(o)) != 0:
+        return None
+    return {k: o.sensors[k].value for k in range(256) if o.sensors[k].supported}
+
+def dgpu():
+    best = None
+    for i in range(n.value):
+        s = read(i)
+        if s and 27 in s and best is None:  # (the iGPU reports no hotspot temperature)
+            best = (i, s)
+    return best[0]
+
+if sys.argv[1] == 'dump':
+    seen = set()
+    for i in range(n.value):
+        s = read(i)
+        if not s or tuple(sorted(s)) in seen:
+            continue
+        seen.add(tuple(sorted(s)))
+        print('adapter', i, ' '.join(f'{NAMES.get(k, k)}={v}' for k, v in s.items()))
+else:
+    seconds = int(sys.argv[2])
+    out = open(sys.argv[3], 'w') if len(sys.argv) > 3 else sys.stdout
+    i = dgpu()
+    keys = [1, 2, 8, 27, 9, 73, 19, 20, 15]
+    print('t ' + ' '.join(NAMES.get(k, str(k)) for k in keys), file=out, flush=True)
+    t0 = time.time()
+    while time.time() - t0 < seconds:
+        s = read(i) or {}
+        print(f'{time.time() - t0:.0f} ' + ' '.join(str(s.get(k, '-')) for k in keys), file=out, flush=True)
+        time.sleep(1)
diff --git a/tools/resdiff.py b/tools/resdiff.py
new file mode 100644
index 0000000..7e9d5f2
--- /dev/null
+++ b/tools/resdiff.py
@@ -0,0 +1,36 @@
+"""Compare two folders of resolve dumps (regpuctl capture's out/res): same file names, mean absolute difference per
+image (0-255) and the mean brightness of each side, sorted by guest address (resolve order is roughly address order
+within a frame, not exactly).
+usage: resdiff.py <a_dir> <b_dir> [min_diff]"""
+import os
+import sys
+
+from PIL import Image
+import numpy as np
+
+a_dir, b_dir = sys.argv[1], sys.argv[2]
+min_diff = float(sys.argv[3]) if len(sys.argv) > 3 else 0.0
+common = sorted(set(os.listdir(a_dir)) & set(os.listdir(b_dir)))
+only_a = sorted(set(os.listdir(a_dir)) - set(os.listdir(b_dir)))
+only_b = sorted(set(os.listdir(b_dir)) - set(os.listdir(a_dir)))
+rows = []
+for name in common:
+    try:
+        a = np.asarray(Image.open(os.path.join(a_dir, name)).convert('RGBA'), dtype=np.float32)
+        b = np.asarray(Image.open(os.path.join(b_dir, name)).convert('RGBA'), dtype=np.float32)
+    except Exception as e:
+        print('skip', name, e)
+        continue
+    if a.shape != b.shape:
+        rows.append((name, -1, 0, 0, f'shape {a.shape} vs {b.shape}'))
+        continue
+    d = np.abs(a[..., :3] - b[..., :3]).mean()
+    rows.append((name, d, a[..., :3].mean(), b[..., :3].mean(), ''))
+for name, d, ma, mb, note in rows:
+    if d < 0 or d >= min_diff:
+        print(f'{name:34s} diff {d:6.2f}  mean {ma:6.1f} vs {mb:6.1f} {note}')
+print(f'{len(common)} common, {len(only_a)} only in a, {len(only_b)} only in b')
+if only_a:
+    print('only a:', ' '.join(only_a[:40]))
+if only_b:
+    print('only b:', ' '.join(only_b[:40]))
diff --git a/tools/rgp/README.md b/tools/rgp/README.md
new file mode 100644
index 0000000..56cfbf5
--- /dev/null
+++ b/tools/rgp/README.md
@@ -0,0 +1,17 @@
+# Reading Radeon GPU Profiler captures without screenshots
+
+Used for FM4's 1440p capture ([../../docs/ports/fm4-vulkan.md](../../docs/ports/fm4-vulkan.md), "Radeon GPU Profiler
+capture"). Windows, Python 3; the `.ps1` scripts read the open RGP window through UI Automation and only read.
+
+Take the capture with the Radeon Developer Tool Suite's `RadeonDeveloperPanelCLI` (it runs its own router: don't start
+`RadeonDeveloperServiceCLI` beside it). A minimized game presents nothing, so use the CLI's draw-count trigger.
+
+| Script | What |
+|---|---|
+| `rgpchunks.py <rgp> [--extract <dir>]` | The .rgp's chunks (AMD RDF container); `--extract` writes each pipeline binary (CodeObject) as `<hash>.elf`, plus the PsoCorrelation chunk. |
+| `rgppipes.py <dir>` | Per pipeline: API PSO hash, vertex (NGG) and pixel registers, scratch, export count, pixel inputs, kill, instruction counts -> `<dir>/pipelines.csv`. Needs the RDTS's LLVM tools: `RDTS_LC_BIN`, or `RDTS_DIR` = the unzipped suite. |
+| `rgpread.ps1`, `rgpscroll.ps1` | The open RGP window's table or tree as TSV (`rgpscroll` reaches rows that are off screen). |
+| `rgpevents.ps1` | Selects each row of Overview -> Pipelines in turn and reads its events: every draw with its pipeline and time. |
+| `rgpjoin.py` | RGP's Pipelines table joined with `pipelines.csv`: GPU time by registers, scratch, size, exports. |
+| `rgpdraws.py` | Draws in order with their pipeline's facts: draws right after a pipeline switch against draws that keep it. |
+| `rgpbarriers.py` | The Barriers table, each barrier matched to the event after it. |
diff --git a/tools/rgp/rgpbarriers.py b/tools/rgp/rgpbarriers.py
new file mode 100644
index 0000000..d8fd0de
--- /dev/null
+++ b/tools/rgp/rgpbarriers.py
@@ -0,0 +1,45 @@
+# RGP's Barriers table (rgpscroll.ps1 -Which tree on Overview -> Barriers) summarised, each barrier matched to the event
+# after it (Event timing order, rgpscroll.ps1 -Which tree on Events -> Event timing).
+#   py -3 rgpbarriers.py <ui-barriers.tsv> <ui-events.tsv>
+import collections, re, sys
+
+text = open(sys.argv[1], encoding='utf-8-sig').read()
+lines = text.split('\n')
+# (The header cells contain line breaks: the data rows start at the first line beginning with a number.)
+rows = [l.split('\t') for l in lines if re.match(r'^\d+\t', l)]
+cols = ['event', 'duration', 'drain', 'stalls', 'ds_decompress', 'hiz_resummarize', 'dcc_decompress', 'fmask_decompress',
+        'fast_clear_eliminate', 'init_mask_ram', 'invalidated', 'flushed', 'type', 'reason']
+
+def us(s):
+    m = re.match(r'([\d.]+)', s or '')
+    return float(m.group(1)) if m else 0.0
+
+print(f'{len(rows)} barriers: duration {sum(us(r[1]) for r in rows):.0f} us, drain {sum(us(r[2]) for r in rows):.0f} us')
+for ci in range(4, 10):
+    hit = [r for r in rows if len(r) > ci and r[ci].strip()]
+    if hit:
+        print(f'  {cols[ci]}: {len(hit)} barriers, ' + ', '.join(f'#{r[0]} {r[ci]}' for r in hit[:8]))
+for ci, name in ((3, 'stalls'), (11, 'flushed'), (12, 'type'), (13, 'reason')):
+    print(f'{name}:', collections.Counter(r[ci].strip() if len(r) > ci else '' for r in rows).most_common(6))
+
+order = []
+for line in open(sys.argv[2], encoding='utf-8-sig'):
+    m = re.match(r'^(\d+) (\S+)', line.split('\t')[0].strip())
+    if m:
+        order.append((int(m.group(1)), re.sub(r'\(.*', '', m.group(2))))
+nxt = {}
+for i, (eid, call) in enumerate(order):
+    if call.startswith('vkCmdPipelineBarrier') and i + 1 < len(order):
+        nxt[eid] = order[i + 1][1]
+after = collections.defaultdict(lambda: [0, 0.0, 0.0])
+for r in rows:
+    a = after[nxt.get(int(r[0]), '?')]
+    a[0] += 1
+    a[1] += us(r[1])
+    a[2] += us(r[2])
+print('followed by (count, duration us, drain us):')
+for k, (n, d, dr) in sorted(after.items(), key=lambda kv: -kv[1][1]):
+    print(f'  {k:28} {n:4} {d:8.1f} {dr:8.1f}')
+print('largest:')
+for r in sorted(rows, key=lambda r: -us(r[1]))[:10]:
+    print(f'  #{r[0]:5} duration {r[1]:>12} drain {r[2]:>12} stalls {r[3]:6} flushed {r[11] if len(r) > 11 else "":12} next {nxt.get(int(r[0]))}')
diff --git a/tools/rgp/rgpchunks.py b/tools/rgp/rgpchunks.py
new file mode 100644
index 0000000..c0bb3b5
--- /dev/null
+++ b/tools/rgp/rgpchunks.py
@@ -0,0 +1,42 @@
+# Reads an .rgp capture (AMD's RDF container: header "AMD_RDF ", u32 version, u32 reserved, i64 directory offset,
+# i64 directory size; 64-byte directory entries {char id[16], u32, u32, i64 header offset, i64 header size,
+# i64 data offset, i64 data size, i64}). Lists the chunks; --extract <dir> writes every CodeObject chunk's ELF (the
+# pipeline binaries the capture saw) as <internal hash>.elf, and the PsoCorrelation and COLoadEvent chunks raw.
+#   py -3 rgpchunks.py <file.rgp> [--extract <dir>]
+import os, struct, sys
+
+path = sys.argv[1]
+data = open(path, 'rb').read()
+ident, version, _res, dir_off, dir_size = struct.unpack_from('<8sIIqq', data, 0)
+print(f'{ident!r} version {version}, {dir_size // 64} chunks, file {len(data) // 1024} KB')
+ENTRY = struct.Struct('<16sIIqqqqq')
+entries = []
+for i in range(dir_size // ENTRY.size):
+    cid, a, b, hoff, hsize, doff, dsize, usize = ENTRY.unpack_from(data, dir_off + i * ENTRY.size)
+    entries.append((cid.rstrip(b'\0').decode('ascii', 'replace'), hoff, hsize, doff, dsize))
+summary = {}
+for e in entries:
+    s = summary.setdefault(e[0], [0, 0])
+    s[0] += 1
+    s[1] += e[4]
+for name, (n, size) in summary.items():
+    print(f'{name:20} x{n:5}  {size // 1024:8} KB')
+
+if '--extract' in sys.argv:
+    out = sys.argv[sys.argv.index('--extract') + 1]
+    os.makedirs(out, exist_ok=True)
+    n = 0
+    for name, hoff, hsize, doff, dsize in entries:
+        body = data[doff:doff + dsize]
+        if name == 'CodeObject':
+            hdr = data[hoff:hoff + hsize]
+            # Header: u32 (pci id / flags), u32, then the 128-bit internal pipeline hash.
+            h = hdr[8:24][::-1].hex().upper() if len(hdr) >= 24 else f'{n:04}'
+            if body[:4] == b'\x7fELF':
+                open(os.path.join(out, f'{h}.elf'), 'wb').write(body)
+                open(os.path.join(out, f'{h}.hdr'), 'wb').write(hdr)
+                n += 1
+        elif name in ('PsoCorrelation', 'COLoadEvent', 'ApiInfo', 'AsicInfo'):
+            open(os.path.join(out, f'{name}.bin'), 'wb').write(body)
+            open(os.path.join(out, f'{name}.hdr'), 'wb').write(data[hoff:hoff + hsize])
+    print('extracted', n, 'pipeline ELFs to', out)
diff --git a/tools/rgp/rgpdraws.py b/tools/rgp/rgpdraws.py
new file mode 100644
index 0000000..002f4e8
--- /dev/null
+++ b/tools/rgp/rgpdraws.py
@@ -0,0 +1,83 @@
+# Per-draw analysis of an RGP capture: events in order (rgpevents.ps1's events-by-pipeline table, by event ID), each
+# with its pipeline's facts (rgppipes.py's pipelines.csv). Compares draws right after a pipeline switch with draws that
+# keep their pipeline, by what changed (export count, vertex or pixel shader size), and lists the passes (from the
+# Event timing list, rgpscroll.ps1 -Which tree on Events -> Event timing).
+#   py -3 rgpdraws.py <events-by-pipeline.tsv> <pipelines.csv> [<ui-events.tsv>]
+import csv, collections, re, statistics, sys
+
+ev = list(csv.DictReader(open(sys.argv[1], encoding='utf-8-sig'), delimiter='\t'))
+facts = {r['api_hash']: r for r in csv.DictReader(open(sys.argv[2]))}
+for e in ev:
+    e['id'] = int(e['event'])
+    e['us'] = float(e['duration_us'] or 0)
+    e['f'] = facts.get(e['api_hash'].replace('0x', '').upper())
+ev.sort(key=lambda e: e['id'])
+draws = [e for e in ev if e['call'].startswith('vkCmdDraw')]
+print(f'{len(ev)} events with a pipeline, {len(draws)} draws; summed draw time {sum(d["us"] for d in draws):.0f} us')
+
+def med(v):
+    return statistics.median(v) if v else 0
+groups = collections.defaultdict(list)
+prev = None
+for d in draws:
+    f, pf = d['f'], prev['f'] if prev else None
+    if prev is None or d['api_hash'] != prev['api_hash']:
+        kind = 'switch'
+        if f and pf:
+            kind += ', exports ' + ('same' if f['vs_export_count'] == pf['vs_export_count'] else 'changed')
+    else:
+        kind = 'same pipeline'
+    groups[kind].append(d['us'])
+    prev = d
+print('\ndraw duration by what came before (RGP duration: start to end, overlapping draws included):')
+for k, v in sorted(groups.items()):
+    print(f'  {k:32} {len(v):5} draws  median {med(v):6.2f} us  mean {statistics.mean(v):6.2f} us  sum {sum(v):8.0f} us')
+
+# Small draws only (under 64 indices or vertices): their time is mostly fixed cost, not work.
+def count(call):
+    m = re.match(r'vkCmdDraw(?:Indexed)?\((\d+)', call)
+    return int(m.group(1)) if m else 0
+small = collections.defaultdict(list)
+prev = None
+for d in draws:
+    if count(d['call']) <= 64:
+        small['switch' if prev is None or d['api_hash'] != prev['api_hash'] else 'same pipeline'].append(d['us'])
+    prev = d
+print('\nsmall draws (<= 64 indices or vertices):')
+for k, v in small.items():
+    print(f'  {k:32} {len(v):5} draws  median {med(v):6.2f} us  mean {statistics.mean(v):6.2f} us')
+
+# By the vertex shader's scratch and register use, small draws only.
+by = collections.defaultdict(list)
+for d in draws:
+    if count(d['call']) <= 64 and d['f']:
+        f = d['f']
+        by[('vs scratch' if int(f['gs_scratch_memory_size'] or 0) else 'vs no scratch') + (', vs sgpr>=100' if int(f['gs_sgpr_count'] or 0) >= 100 else ', vs sgpr<100')].append(d['us'])
+print('\nsmall draws by vertex shader:')
+for k, v in sorted(by.items()):
+    print(f'  {k:32} {len(v):5} draws  median {med(v):6.2f} us  mean {statistics.mean(v):6.2f} us')
+
+if len(sys.argv) > 3:
+    # Passes: the Event timing list's group rows ("Color pass N", "Depth-only pass N", ...) and the events under them.
+    order = []
+    cur = None
+    for line in open(sys.argv[3], encoding='utf-8-sig'):
+        name = line.split('\t')[0].strip()
+        m = re.match(r'^(\d+) (vk\w+)', name)
+        if m:
+            order.append((int(m.group(1)), cur))
+        elif name:
+            cur = name
+    pass_of = dict(order)
+    per = collections.OrderedDict()
+    prev = None
+    for d in draws:
+        p = pass_of.get(d['id'], '?')
+        s = per.setdefault(p, [0, 0, 0.0])
+        s[0] += 1
+        s[1] += prev is not None and d['api_hash'] != prev['api_hash']
+        s[2] += d['us']
+        prev = d
+    print('\npasses with the most draws (draws, pipeline switches, summed draw time):')
+    for p, (n, sw, t) in sorted(per.items(), key=lambda kv: -kv[1][0])[:12]:
+        print(f'  {p:28} {n:5} draws {sw:5} switches {t:8.0f} us')
diff --git a/tools/rgp/rgpevents.ps1 b/tools/rgp/rgpevents.ps1
new file mode 100644
index 0000000..1b86194
--- /dev/null
+++ b/tools/rgp/rgpevents.ps1
@@ -0,0 +1,47 @@
+# With RGP's Overview -> Pipelines pane open: selects each pipeline row in turn (UI Automation SelectionItemPattern) and
+# reads the Events table under it (event ID, call, duration), so every draw gets its time and its pipeline.
+# Only changes the row selection. Output: bucket, API PSO hash, event ID, call, duration (us), share.
+#   rgpevents.ps1 -Out events-by-pipeline.tsv
+param([Parameter(Mandatory)] [string]$Out)
+Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes
+$A = [Windows.Automation.AutomationElement]
+$p = Get-Process RadeonGPUProfiler -ErrorAction Stop | Select-Object -First 1
+$root = $A::FromHandle($p.MainWindowHandle)
+$null = $root.FindAll([Windows.Automation.TreeScope]::Descendants, [Windows.Automation.Condition]::TrueCondition)
+function Grid($type) {
+    $cond = New-Object Windows.Automation.PropertyCondition($A::ControlTypeProperty, $type)
+    foreach ($g in $root.FindAll([Windows.Automation.TreeScope]::Descendants, $cond)) {
+        $h = ($g.FindAll([Windows.Automation.TreeScope]::Children,
+            (New-Object Windows.Automation.PropertyCondition($A::ControlTypeProperty, [Windows.Automation.ControlType]::Header))) | ForEach-Object { $_.Current.Name }) -join '|'
+        if ($type -eq [Windows.Automation.ControlType]::Tree -and $h -like 'Bucket ID|*') { return $g }
+        if ($type -eq [Windows.Automation.ControlType]::Table -and $h -like 'Event ID|*') { return $g }
+    }
+    return $null
+}
+$tree = Grid ([Windows.Automation.ControlType]::Tree)
+if (-not $tree) { throw 'the Pipelines tree (Bucket ID column) is not on screen' }
+$tgp = $tree.GetCurrentPattern([Windows.Automation.GridPattern]::Pattern)
+$lines = New-Object System.Collections.Generic.List[string]
+$lines.Add("bucket`tapi_hash`tevent`tcall`tduration_us`tshare")
+$done = 0
+for ($r = 0; $r -lt $tgp.Current.RowCount; $r++) {
+    $cell = $tgp.GetItem($r, 0)
+    $bucket = $cell.Current.Name.Trim()
+    if ($bucket -notmatch '^\d+$') { continue } # (VS / FS sub-rows)
+    $hash = $tgp.GetItem($r, 1).Current.Name.Trim()
+    try { $cell.GetCurrentPattern([Windows.Automation.SelectionItemPattern]::Pattern).Select() } catch { continue }
+    Start-Sleep -Milliseconds 150
+    $table = Grid ([Windows.Automation.ControlType]::Table)
+    if (-not $table) { continue }
+    $egp = $table.GetCurrentPattern([Windows.Automation.GridPattern]::Pattern)
+    for ($e = 0; $e -lt $egp.Current.RowCount; $e++) {
+        $id = $egp.GetItem($e, 0).Current.Name.Trim()
+        $call = $egp.GetItem($e, 1).Current.Name.Trim()
+        $d = ($egp.GetItem($e, 2).Current.Name -replace '\s+', ' ').Trim()
+        if ($d -match '([\d.]+)\s*\S*s\s*\[([\d.]+)%\]') { $lines.Add("$bucket`t$hash`t$id`t$call`t$($Matches[1])`t$($Matches[2])") }
+        elseif ($id) { $lines.Add("$bucket`t$hash`t$id`t$call`t`t$d") }
+    }
+    $done++
+}
+$lines | Set-Content -Path $Out -Encoding utf8
+"$done pipelines, $($lines.Count - 1) events -> $Out"
diff --git a/tools/rgp/rgpjoin.py b/tools/rgp/rgpjoin.py
new file mode 100644
index 0000000..43de004
--- /dev/null
+++ b/tools/rgp/rgpjoin.py
@@ -0,0 +1,42 @@
+# Joins RGP's Pipelines table (read from the window: rgpscroll.ps1 -Which tree) with the pipeline binaries' facts
+# (rgppipes.py's pipelines.csv): where the captured GPU time goes by scratch, register use, instruction count, exports.
+#   py -3 rgpjoin.py <ui-pipelines-all.tsv> <pipelines.csv>
+import csv, re, statistics, sys
+
+ui = [l.rstrip('\n').split('\t') for l in open(sys.argv[1], encoding='utf-8-sig')][1:]
+facts = {r['api_hash']: r for r in csv.DictReader(open(sys.argv[2]))}
+rows = []
+for c in ui:
+    if not c or not c[0].strip().isdigit():
+        continue  # (a VS / FS sub-row)
+    h = c[1].replace('0x', '').upper()
+    dur = float(re.match(r'([\d.]+)', c[2]).group(1))
+    ev = int(re.match(r'(\d+)', c[3]).group(1)) if c[3] else 0
+    f = facts.get(h)
+    rows.append((int(c[0]), h, dur, ev, f))
+total = sum(r[2] for r in rows)
+matched = [r for r in rows if r[4]]
+print(f'{len(rows)} pipelines in the table, {len(matched)} matched to binaries; summed event time {total:.0f} us')
+
+def share(name, pred):
+    sel = [r for r in matched if pred(r[4])]
+    t = sum(r[2] for r in sel)
+    ev = sum(r[3] for r in sel)
+    print(f'{name:44} {len(sel):4} pipelines  {t:8.0f} us ({100 * t / total:5.1f}%)  {ev:5} events  {t / max(ev, 1):6.2f} us/event')
+
+i = lambda f, k: int(f.get(k) or 0)
+share('vertex stage spills to scratch', lambda f: i(f, 'gs_scratch_memory_size') > 0)
+share('no vertex scratch', lambda f: i(f, 'gs_scratch_memory_size') == 0)
+share('vertex sgpr >= 100', lambda f: i(f, 'gs_sgpr_count') >= 100)
+share('vertex sgpr < 100', lambda f: i(f, 'gs_sgpr_count') < 100)
+share('pixel kill on', lambda f: f.get('kill_enable') == 'true')
+share('pixel kill off', lambda f: f.get('kill_enable') == 'false')
+for lo, hi in ((0, 1000), (1000, 2000), (2000, 3000), (3000, 99999)):
+    share(f'vertex instructions {lo}-{hi}', lambda f, lo=lo, hi=hi: lo <= i(f, 'gs_ins') < hi)
+for lo, hi in ((0, 1000), (1000, 3000), (3000, 6000), (6000, 99999)):
+    share(f'pixel instructions {lo}-{hi}', lambda f, lo=lo, hi=hi: lo <= i(f, 'ps_ins') < hi)
+print('\ntop 12 by time:')
+for b, h, dur, ev, f in sorted(rows, key=lambda r: -r[2])[:12]:
+    if f:
+        print(f'  bucket {b:3} {h} {dur:7.1f} us {ev:4} ev {dur / max(ev, 1):6.2f} us/ev | vs sgpr {f["gs_sgpr_count"]:>3} vgpr {f["gs_vgpr_count"]:>3} '
+              f'scratch {f["gs_scratch_memory_size"] or 0:>2} ins {f["gs_ins"]:>5} | ps vgpr {f["ps_vgpr_count"]:>3} ins {f["ps_ins"]:>5} kill {f["kill_enable"]} | exports {f["vs_export_count"]}')
diff --git a/tools/rgp/rgppipes.py b/tools/rgp/rgppipes.py
new file mode 100644
index 0000000..8a4e170
--- /dev/null
+++ b/tools/rgp/rgppipes.py
@@ -0,0 +1,94 @@
+# Per-pipeline facts from an .rgp capture's pipeline binaries (extract them first: rgpchunks.py <rgp> --extract <dir>):
+# for each, the API PSO hash (RGP's Pipelines "Hash" column, from the PsoCorrelation chunk), the vertex (NGG "gs") and
+# pixel stages' scalar/vector registers and scratch, the export count, the pixel inputs, kill, and instruction counts.
+# Writes <dir>/pipelines.csv and prints a summary of what drives context rolls and register pressure.
+#   py -3 rgppipes.py <dir> [--hash 0x56FD04EAA0834D8B ...]
+import collections, concurrent.futures as cf, csv, os, re, subprocess, sys
+
+# The Radeon Developer Tool Suite's LLVM tools: RDTS_LC_BIN, else <RDTS_DIR>/utils/lc/opencl/bin.
+T = os.environ.get('RDTS_LC_BIN') or os.path.join(os.environ.get('RDTS_DIR', '.'), 'utils', 'lc', 'opencl', 'bin')
+d = sys.argv[1]
+want = [h.upper().replace('0X', '') for h in sys.argv[sys.argv.index('--hash') + 1:]] if '--hash' in sys.argv else []
+
+# PsoCorrelation: each internal hash (16 bytes, as stored in a CodeObject header at offset 8) is preceded by its
+# 8-byte API PSO hash.
+corr = open(os.path.join(d, 'PsoCorrelation.bin'), 'rb').read()
+elfs = sorted(f for f in os.listdir(d) if f.endswith('.elf'))
+api_of = {}
+for f in elfs:
+    hdr = open(os.path.join(d, f[:-4] + '.hdr'), 'rb').read()
+    internal = hdr[8:24]
+    pos = corr.find(internal)
+    if pos >= 8:
+        api_of[f] = corr[pos - 8:pos][::-1].hex().upper()
+
+FIELDS = ['sgpr_count', 'vgpr_count', 'scratch_memory_size']
+def facts(f):
+    p = os.path.join(d, f)
+    notes = subprocess.run([os.path.join(T, 'llvm-readobj.exe'), '--notes', p], capture_output=True, text=True).stdout
+    r = {'file': f, 'api_hash': api_of.get(f, '')}
+    # The hardware stages block: ".hardware_stages:" then ".gs:" / ".ps:" sections with their fields.
+    stage = None
+    in_hw = False
+    for line in notes.splitlines():
+        s = line.strip()
+        if s == '.hardware_stages:':
+            in_hw = True
+            continue
+        if in_hw:
+            m = re.match(r'\.(gs|ps|vs|hs|es|ls|cs):$', s)
+            if m:
+                stage = m.group(1)
+                continue
+            m = re.match(r'\.(\w+):\s+(\S+)', s)
+            if m and stage and m.group(1) in FIELDS:
+                r[f'{stage}_{m.group(1)}'] = int(m.group(2), 0) if re.match(r'^-?(0x)?[0-9a-fA-F]+$', m.group(2)) else m.group(2)
+            if re.match(r'\.(shaders|pipelines|api|registers|graphics_registers|internal_pipeline_hash):', s) and not s.startswith('.hardware'):
+                in_hw = False
+        for key in ('vs_export_count', 'num_interps', 'kill_enable', 'z_export_enable'):
+            m = re.match(r'\.' + key + r':\s+(\S+)', s)
+            if m and key not in r:
+                r[key] = m.group(1)
+    dis = subprocess.run([os.path.join(T, 'llvm-objdump.exe'), '-d', '--mcpu=gfx1100', p], capture_output=True, text=True).stdout
+    cur = None
+    for line in dis.splitlines():
+        m = re.match(r'^[0-9a-f]+ <(_amdgpu_\w+)>:', line)
+        if m:
+            cur = m.group(1)
+            continue
+        if cur and re.match(r'^\s+[a-z_0-9]+ .*//', line):
+            k = 'gs_ins' if 'gs' in cur else 'ps_ins' if 'ps' in cur else 'other_ins'
+            r[k] = r.get(k, 0) + 1
+    return r
+
+with cf.ThreadPoolExecutor(16) as ex:
+    rows = list(ex.map(facts, elfs))
+keys = ['api_hash', 'gs_sgpr_count', 'gs_vgpr_count', 'gs_scratch_memory_size', 'gs_ins', 'ps_sgpr_count', 'ps_vgpr_count',
+        'ps_scratch_memory_size', 'ps_ins', 'vs_export_count', 'num_interps', 'kill_enable', 'z_export_enable', 'file']
+with open(os.path.join(d, 'pipelines.csv'), 'w', newline='') as fh:
+    w = csv.DictWriter(fh, keys, extrasaction='ignore')
+    w.writeheader()
+    w.writerows(rows)
+
+g = [r for r in rows if 'gs_sgpr_count' in r]
+print(f'{len(rows)} binaries, {len(g)} graphics pipelines, {len(api_of)} with an API hash')
+def dist(key, rs=g):
+    c = collections.Counter(r.get(key) for r in rs)
+    return ', '.join(f'{k}: {v}' for k, v in sorted(c.items(), key=lambda kv: (kv[0] is None, kv[0] if not isinstance(kv[0], str) else 0)))
+sp = [r for r in g if r.get('gs_scratch_memory_size', 0)]
+pp = [r for r in g if r.get('ps_scratch_memory_size', 0)]
+print(f'vertex stage with scratch: {len(sp)} (sizes {dist("gs_scratch_memory_size", sp)}); pixel stage with scratch: {len(pp)}')
+print('vertex sgpr >= 100:', sum(1 for r in g if r.get('gs_sgpr_count', 0) >= 100), ' pixel sgpr >= 100:', sum(1 for r in g if r.get('ps_sgpr_count', 0) >= 100))
+import statistics
+for k in ('gs_sgpr_count', 'gs_vgpr_count', 'gs_ins', 'ps_sgpr_count', 'ps_vgpr_count', 'ps_ins'):
+    v = sorted(r.get(k, 0) for r in g)
+    print(f'{k:16} median {v[len(v) // 2]:5}  p90 {v[int(len(v) * 0.9)]:5}  max {v[-1]:5}')
+print('vs_export_count:', dist('vs_export_count'))
+print('num_interps:    ', dist('num_interps'))
+print('kill_enable:    ', dist('kill_enable'))
+print('scratch vs not, median vertex instructions:', statistics.median([r.get('gs_ins', 0) for r in sp]) if sp else '-',
+      statistics.median([r.get('gs_ins', 0) for r in g if not r.get('gs_scratch_memory_size', 0)]))
+for h in want:
+    for r in rows:
+        if r['api_hash'].endswith(h[-16:]):
+            print(h, {k: r.get(k) for k in keys})
diff --git a/tools/rgp/rgpread.ps1 b/tools/rgp/rgpread.ps1
new file mode 100644
index 0000000..ff44072
--- /dev/null
+++ b/tools/rgp/rgpread.ps1
@@ -0,0 +1,53 @@
+# Reads the tables of the open Radeon GPU Profiler window through Windows UI Automation (the accessibility tree Qt
+# publishes), so a pane's rows come out as text instead of screenshots. It only reads; it clicks nothing.
+#   rgpread.ps1 [-Out file.tsv] [-MaxRows 5000] [-Probe]
+#   -Probe: print the element types found (to see whether the tables are exposed at all).
+param([string]$Out = '', [int]$MaxRows = 5000, [switch]$Probe)
+Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes
+$p = Get-Process RadeonGPUProfiler -ErrorAction Stop | Select-Object -First 1
+$root = [Windows.Automation.AutomationElement]::FromHandle($p.MainWindowHandle)
+if (-not $root) { throw 'no window' }
+$all = $root.FindAll([Windows.Automation.TreeScope]::Descendants, [Windows.Automation.Condition]::TrueCondition)
+if ($Probe) {
+    "elements: $($all.Count)"
+    $all | ForEach-Object { $_.Current.ControlType.ProgrammaticName } | Group-Object | Sort-Object Count -Descending | Select-Object -First 25 | ForEach-Object { "{0,6} {1}" -f $_.Count, $_.Name }
+    "--- tables:"
+    foreach ($e in $all) {
+        $t = $e.Current.ControlType
+        if ($t -eq [Windows.Automation.ControlType]::Table -or $t -eq [Windows.Automation.ControlType]::DataGrid -or $t -eq [Windows.Automation.ControlType]::Tree) {
+            "{0} '{1}' children {2}" -f $t.ProgrammaticName, $e.Current.Name, $e.FindAll([Windows.Automation.TreeScope]::Children, [Windows.Automation.Condition]::TrueCondition).Count
+        }
+    }
+    return
+}
+# Every table: its header items, then each row's cells (DataItem children, or the cells by grid position).
+$lines = New-Object System.Collections.Generic.List[string]
+foreach ($e in $all) {
+    $t = $e.Current.ControlType
+    if ($t -ne [Windows.Automation.ControlType]::Table -and $t -ne [Windows.Automation.ControlType]::DataGrid -and $t -ne [Windows.Automation.ControlType]::Tree) { continue }
+    $lines.Add("### $($t.ProgrammaticName) $($e.Current.Name)")
+    $kids = $e.FindAll([Windows.Automation.TreeScope]::Children, [Windows.Automation.Condition]::TrueCondition)
+    $row = New-Object System.Collections.Generic.List[string]
+    $n = 0
+    foreach ($k in $kids) {
+        $kt = $k.Current.ControlType
+        if ($kt -eq [Windows.Automation.ControlType]::Header) {
+            $h = $k.FindAll([Windows.Automation.TreeScope]::Children, [Windows.Automation.Condition]::TrueCondition) | ForEach-Object { $_.Current.Name }
+            $lines.Add(($h -join "`t"))
+            continue
+        }
+        $cells = $k.FindAll([Windows.Automation.TreeScope]::Children, [Windows.Automation.Condition]::TrueCondition)
+        if ($cells.Count -gt 0) {
+            $vals = foreach ($c in $cells) {
+                $v = $c.Current.Name
+                try { $vp = $c.GetCurrentPattern([Windows.Automation.ValuePattern]::Pattern); if ($vp.Current.Value) { $v = $vp.Current.Value } } catch {}
+                $v
+            }
+            $lines.Add(($vals -join "`t"))
+        } else {
+            $lines.Add($k.Current.Name)
+        }
+        if (++$n -ge $MaxRows) { break }
+    }
+}
+if ($Out) { $lines | Set-Content -Path $Out -Encoding utf8; "wrote $($lines.Count) lines to $Out" } else { $lines | Select-Object -First 60 }
diff --git a/tools/rgp/rgpscroll.ps1 b/tools/rgp/rgpscroll.ps1
new file mode 100644
index 0000000..7de4b0a
--- /dev/null
+++ b/tools/rgp/rgpscroll.ps1
@@ -0,0 +1,28 @@
+# Reads every row of a Radeon GPU Profiler table or tree through UI Automation's grid interface (GridPattern.GetItem
+# by row and column), which reaches rows that aren't on screen. Only reads; clicks and scrolls nothing.
+#   rgpscroll.ps1 -Out file.tsv [-Which tree|table] [-Index 0]
+#   Output: a header line (the column names), then one tab-separated line per row.
+param([Parameter(Mandatory)] [string]$Out, [ValidateSet('tree', 'table')] [string]$Which = 'tree', [int]$Index = 0)
+Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes
+$A = [Windows.Automation.AutomationElement]
+$p = Get-Process RadeonGPUProfiler -ErrorAction Stop | Select-Object -First 1
+$root = $A::FromHandle($p.MainWindowHandle)
+$type = if ($Which -eq 'tree') { [Windows.Automation.ControlType]::Tree } else { [Windows.Automation.ControlType]::Table }
+$cond = New-Object Windows.Automation.PropertyCondition($A::ControlTypeProperty, $type)
+$grids = $root.FindAll([Windows.Automation.TreeScope]::Descendants, $cond)
+if ($grids.Count -le $Index) { throw "no $Which number $Index (found $($grids.Count))" }
+$grid = $grids[$Index]
+$gp = $grid.GetCurrentPattern([Windows.Automation.GridPattern]::Pattern)
+$rowsN = $gp.Current.RowCount; $colsN = $gp.Current.ColumnCount
+$headers = $grid.FindAll([Windows.Automation.TreeScope]::Children,
+    (New-Object Windows.Automation.PropertyCondition($A::ControlTypeProperty, [Windows.Automation.ControlType]::Header))) | ForEach-Object { $_.Current.Name }
+$lines = New-Object System.Collections.Generic.List[string]
+$lines.Add(($headers -join "`t"))
+for ($r = 0; $r -lt $rowsN; $r++) {
+    $vals = for ($c = 0; $c -lt $colsN; $c++) {
+        try { ($gp.GetItem($r, $c).Current.Name -replace '\s+', ' ').Trim() } catch { '' }
+    }
+    $lines.Add(($vals -join "`t"))
+}
+$lines | Set-Content -Path $Out -Encoding utf8
+"$rowsN rows x $colsN columns -> $Out"
